+#pragma once
+#include "../module.h"
+
+namespace bedrock::modules {
+
+// Hotbar Slot — ported from LeviLaunchroid's inbuilt "hotbar_slot" module.
+//
+// The Kotlin module (com/bedrock/client/modules/impl/HotbarSlotModule.kt)
+// owns the floating 1..9 buttons above the game window and the per-slot
+// settings; this native module is the in-game half of the feature. It will
+// receive every slot press/release made on those buttons and answer
+// "does slot N hold an item?" queries for the item-icons mode.
+//
+// The actual in-game hooks are intentionally left as TODO notes instead of
+// guessed offsets/symbols — follow the same convention as MinecraftLoader.cpp:
+// resolve the real symbols during bring-up and fill the marked spots in.
+class HotbarSlot : public Module {
+public:
+    HotbarSlot()
+        : Module("Hotbar Slot", "خانات الهوت بار (1-9)", ModuleCategory::CLIENT) {}
+
+    void onEnable() override;
+    void onDisable() override;
+
+    // Called by Kotlin when a slot button is pressed / released. slotIndex is
+    // the hotbar index 0..8 (button label = slotIndex + 1).
+    void setSlotPressed(int slotIndex, bool down);
+
+    // Called by Kotlin while the item-icons mode is on (polled a few times per
+    // second). Returns whether that hotbar slot currently holds an item.
+    bool hasItem(int slotIndex) const;
+
+private:
+    bool iconsEnabled = false;
+};
+
+} // namespace
