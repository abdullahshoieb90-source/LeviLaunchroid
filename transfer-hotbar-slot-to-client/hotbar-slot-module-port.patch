+++ b/app/src/main/java/com/bedrock/client/modules/hotbarslot/HotbarSlotButton.kt
@@ -0,0 +1,198 @@
+package com.bedrock.client.modules.hotbarslot
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.os.Handler
+import android.os.Looper
+import android.util.AttributeSet
+import android.view.MotionEvent
+import android.view.View
+
+/**
+ * One tappable hotbar-slot button (slot 1..9).
+ *
+ * Visual behaviour is ported from LeviLaunchroid's HotbarSlotOverlay:
+ *  - normal: rounded translucent button with the slot number in the middle;
+ *  - pressed: inverted highlight;
+ *  - item-icons mode (with an item present): the number is removed and only a
+ *    hollow frame is drawn around the "icon window", so the real item rendered
+ *    by the game underneath stays visible through the middle of the button.
+ *
+ * Touch behaviour:
+ *  - tap / hold  -> select the slot (key down on touch, key up on release);
+ *  - long-press and drag -> move the button (position is committed on release).
+ */
+class HotbarSlotButton @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    private val slot: Int,
+    private val listener: Listener
+) : View(context, attrs) {
+
+    interface Listener {
+        fun onSlotKey(slot: Int, down: Boolean)
+        fun onDragStart(slot: Int)
+        fun onDragMove(slot: Int, dx: Float, dy: Float)
+        fun onDragEnd(slot: Int)
+    }
+
+    private val density = resources.displayMetrics.density
+    private val handler = Handler(Looper.getMainLooper())
+
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    /** True while the module's item-icons mode is enabled (host refreshes this). */
+    var iconsMode = false
+        set(value) {
+            if (field != value) {
+                field = value
+                invalidate()
+            }
+        }
+
+    /** Set by the host when the game reported an item in this slot. */
+    var itemPresent = false
+        set(value) {
+            if (field != value) {
+                field = value
+                invalidate()
+            }
+        }
+
+    var pressed = false
+        private set
+
+    private var touchedDown = false
+    private var dragging = false
+    private var initialRawX = 0f
+    private var initialRawY = 0f
+
+    /** The icon window leaves this margin (as a fraction of the size) empty. */
+    private val iconMargin = 0.18f
+
+    private val longPressRunnable = Runnable {
+        if (touchedDown && !dragging) {
+            // Cancel the "key down" that was sent on touch and switch to dragging.
+            dragging = true
+            listener.onSlotKey(slot, false)
+            listener.onDragStart(slot)
+        }
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val size = resolveSize(suggestedMinimumWidth, widthMeasureSpec)
+        setMeasuredDimension(size, size)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val size = minOf(width, height).toFloat()
+        if (size <= 0f) return
+
+        val iconWindow = itemPresent && iconsMode
+        val radius = size * 0.22f
+
+        if (iconWindow) {
+            // Hollow frame around the icon window: the middle stays fully
+            // transparent so the vanilla hotbar item can be seen and tapped.
+            ringPaint.style = Paint.Style.STROKE
+            ringPaint.strokeWidth = size * iconMargin
+            ringPaint.color = if (pressed) 0xE6FFFFFF.toInt() else 0x59FFFFFF
+            val inset = size * iconMargin * 0.5f
+            canvas.drawRoundRect(
+                RectF(inset, inset, size - inset, size - inset),
+                radius * 0.5f, radius * 0.5f, ringPaint
+            )
+            return
+        }
+
+        if (pressed) {
+            fillPaint.style = Paint.Style.FILL
+            fillPaint.color = 0xE6FFFFFF.toInt()
+            canvas.drawRoundRect(RectF(0f, 0f, size, size), radius, radius, fillPaint)
+            drawNumber(canvas, size, Color.rgb(26, 26, 26), dp(4f))
+        } else {
+            fillPaint.style = Paint.Style.FILL
+            fillPaint.color = 0x66000000.toInt()
+            canvas.drawRoundRect(RectF(0f, 0f, size, size), radius, radius, fillPaint)
+            ringPaint.style = Paint.Style.STROKE
+            ringPaint.strokeWidth = dp(1.5f)
+            ringPaint.color = 0x66FFFFFF
+            canvas.drawRoundRect(
+                RectF(dp(1f), dp(1f), size - dp(1f), size - dp(1f)),
+                radius, radius, ringPaint
+            )
+            drawNumber(canvas, size, Color.WHITE, 0f)
+        }
+    }
+
+    private fun drawNumber(canvas: Canvas, size: Float, color: Int, yShiftPx: Float) {
+        textPaint.isAntiAlias = true
+        textPaint.color = color
+        textPaint.textSize = size * 0.46f
+        textPaint.textAlign = Paint.Align.CENTER
+        textPaint.typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+        val fm = textPaint.fontMetrics
+        val baseline = (size - (fm.ascent + fm.descent)) / 2f + yShiftPx
+        canvas.drawText(slot.toString(), size / 2f, baseline, textPaint)
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                touchedDown = true
+                dragging = false
+                initialRawX = event.rawX
+                initialRawY = event.rawY
+                pressed = true
+                invalidate()
+                listener.onSlotKey(slot, true)
+                handler.postDelayed(longPressRunnable, LONG_PRESS_MS)
+                return true
+            }
+
+            MotionEvent.ACTION_MOVE -> {
+                if (!touchedDown) return true
+                val dx = event.rawX - initialRawX
+                val dy = event.rawY - initialRawY
+                if (dragging) {
+                    listener.onDragMove(slot, dx, dy)
+                } else if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) {
+                    // Finger moved before the long press fired: this stays a
+                    // normal press/release, so stop waiting for the long press.
+                    handler.removeCallbacks(longPressRunnable)
+                }
+                return true
+            }
+
+            MotionEvent.ACTION_CANCEL, MotionEvent.ACTION_UP -> {
+                handler.removeCallbacks(longPressRunnable)
+                if (!touchedDown) return true
+                touchedDown = false
+                pressed = false
+                invalidate()
+                if (dragging) {
+                    dragging = false
+                    listener.onDragEnd(slot)
+                } else {
+                    listener.onSlotKey(slot, false)
+                }
+                return true
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    private fun dp(value: Float): Float = value * density
+
+    companion object {
+        private const val LONG_PRESS_MS = 400L
+        private const val DRAG_THRESHOLD = 10f
+    }
+}
