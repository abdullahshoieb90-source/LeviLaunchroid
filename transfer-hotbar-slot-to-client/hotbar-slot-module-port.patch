+#include "hotbar_slot.h"
+#include "../module_manager.h"
+#include "../../logger/logger.h"
+#include <jni.h>
+
+namespace bedrock::modules {
+
+void HotbarSlot::onEnable() {
+    enabled = true;
+    LOGI("HotbarSlot", "Enabled");
+    // TODO(in-game): when the module is enabled the launcher's floating
+    // buttons take over hotbar selection. If vanilla hotbar tapping should be
+    // suppressed while the buttons cover it, hook the touch/UI handler here —
+    // the exact symbol is resolved during game bring-up (see MinecraftLoader).
+}
+
+void HotbarSlot::onDisable() {
+    enabled = false;
+    LOGI("HotbarSlot", "Disabled");
+}
+
+void HotbarSlot::setSlotPressed(int slotIndex, bool down) {
+    if (slotIndex < 0 || slotIndex > 8) return;
+    LOGI("HotbarSlot", "Slot %d %s", slotIndex + 1, down ? "pressed" : "released");
+    // TODO(in-game): selecting a hotbar slot is equivalent to the vanilla
+    // numeric key 1..9: find the local player and write `selectedSlot`
+    // (clamped to 0..8). The player/slot offset is resolved during game
+    // bring-up — intentionally not guessed here.
+}
+
+bool HotbarSlot::hasItem(int slotIndex) const {
+    if (slotIndex < 0 || slotIndex > 8) return false;
+    // TODO(in-game): read the item present in the hotbar slot from the local
+    // player's inventory container (slot index + 9 * hotbar row). Return
+    // false until the container access is implemented, which matches the
+    // original launcher behaviour when no item is detected.
+    return false;
+}
+
+} // namespace
+
+extern "C" {
+
+JNIEXPORT void JNICALL
+Java_com_bedrock_client_modules_impl_HotbarSlotModule_nativeSetEnabledImpl(
+    JNIEnv* env, jobject thiz, jboolean enabled) {
+    bedrock::modules::ModuleManager::getInstance().setEnabled("Hotbar Slot", enabled);
+}
+
+JNIEXPORT void JNICALL
+Java_com_bedrock_client_modules_impl_HotbarSlotModule_nativeSelectSlot(
+    JNIEnv* env, jobject thiz, jint slotIndex, jboolean down) {
+    auto mod = bedrock::modules::ModuleManager::getInstance().getModule("Hotbar Slot");
+    if (!mod) return;
+    dynamic_cast<bedrock::modules::HotbarSlot*>(mod.get())->setSlotPressed(slotIndex, down);
+}
+
+JNIEXPORT jboolean JNICALL
+Java_com_bedrock_client_modules_impl_HotbarSlotModule_nativeHasItem(
+    JNIEnv* env, jobject thiz, jint slotIndex) {
+    auto mod = bedrock::modules::ModuleManager::getInstance().getModule("Hotbar Slot");
+    if (!mod) return JNI_FALSE;
+    return dynamic_cast<bedrock::modules::HotbarSlot*>(mod.get())->hasItem(slotIndex)
+        ? JNI_TRUE : JNI_FALSE;
+}
+
+} // extern "C"
