@@ -0,0 +1,43 @@
+package com.bedrock.client.modules.hotbarslot
+
+import android.app.Activity
+import com.bedrock.client.modules.ModuleManager
+import com.bedrock.client.modules.impl.HotbarSlotModule
+import java.lang.ref.WeakReference
+
+/**
+ * Bridges the [HotbarSlotModule] (module list switch) with the on-screen
+ * [HotbarSlotHost] that lives inside the game Activity.
+ *
+ * The game Activity calls [attach] / [detach]; the module calls
+ * [notifyEnabled] when it is toggled. This object intentionally holds only a
+ * weak reference so it never leaks the Activity.
+ */
+object HotbarSlotController {
+
+    private var hostRef: WeakReference<HotbarSlotHost>? = null
+
+    fun attach(activity: Activity) {
+        detach()
+        val host = HotbarSlotHost(activity)
+        hostRef = WeakReference(host)
+        if (moduleEnabled()) {
+            host.show()
+        }
+    }
+
+    fun detach() {
+        hostRef?.get()?.destroy()
+        hostRef = null
+    }
+
+    fun notifyEnabled(enabled: Boolean) {
+        val host = hostRef?.get() ?: return
+        if (enabled) host.show() else host.hide()
+    }
+
+    fun currentModule(): HotbarSlotModule? =
+        ModuleManager.getInstance().getModule(HotbarSlotModule.NAME) as? HotbarSlotModule
+
+    private fun moduleEnabled(): Boolean = currentModule()?.isEnabled == true
+}
diff --git a/app/src/main/java/com/bedrock/client/modules/hotbarslot/HotbarSlotHost.kt b/app/src/main/java/com/bedrock/client/modules/hotbarslot/HotbarSlotHost.kt
new file mode 100644
index 0000000..330d193
--- /dev/null
+++ b/app/src/main/java/com/bedrock/client/modules/hotbarslot/HotbarSlotHost.kt
@@ -0,0 +1,252 @@
+package com.bedrock.client.modules.hotbarslot
+
+import android.app.Activity
+import android.graphics.PixelFormat
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.ViewGroup
+import android.view.WindowManager
+
+/**
+ * Owns the 9 floating hotbar-slot buttons while the module is active inside a
+ * game Activity.
+ *
+ * The buttons are added as application-panel windows above the game surface
+ * (the same technique LeviLaunchroid's BaseOverlayButton uses), which keeps
+ * them working even when the game renders into the Activity window. If the
+ * window token is not attached yet, showing is retried for a short while (the
+ * game Activity builds its window content after onCreate).
+ */
+class HotbarSlotHost(private val activity: Activity) : HotbarSlotButton.Listener {
+
+    private class Entry(val slot: Int, val button: HotbarSlotButton, val sizePx: Int) {
+        var x = 0
+        var y = 0
+        var wmParams: WindowManager.LayoutParams? = null
+        var dragBaseX = 0
+        var dragBaseY = 0
+        var dragBaseReady = false
+    }
+
+    private val prefs = HotbarSlotPrefs(activity)
+    private val windowManager = activity.getSystemService(Activity.WINDOW_SERVICE) as WindowManager
+    private val density = activity.resources.displayMetrics.density
+    private val handler = Handler(Looper.getMainLooper())
+
+    private val entries = mutableListOf<Entry>()
+    private var showing = false
+    private var destroyed = false
+
+    private val iconPollRunnable = object : Runnable {
+        override fun run() {
+            if (!showing || destroyed) return
+            val iconsEnabled = prefs.isIconsEnabled()
+            val module = HotbarSlotController.currentModule()
+            for (entry in entries) {
+                entry.button.iconsMode = iconsEnabled
+                if (iconsEnabled && module != null) {
+                    entry.button.itemPresent = module.hasItemNative(entry.slot - 1)
+                }
+            }
+            handler.postDelayed(this, ICON_POLL_MS)
+        }
+    }
+
+    fun show(retriesLeft: Int = SHOW_RETRIES) {
+        if (showing || destroyed) return
+        if (activity.isFinishing || activity.isDestroyed) {
+            destroyed = true
+            return
+        }
+        if (activity.window.decorView.windowToken == null) {
+            // Window not attached yet (the module can be enabled right after the
+            // Activity is created) -> retry shortly.
+            if (retriesLeft > 0) {
+                handler.postDelayed({ if (!destroyed && !showing) show(retriesLeft - 1) }, 100)
+            }
+            return
+        }
+
+        showing = true
+        buildEntries()
+        handler.post(iconPollRunnable)
+    }
+
+    fun hide() {
+        if (!showing) return
+        showing = false
+        handler.removeCallbacks(iconPollRunnable)
+        clearViews()
+    }
+
+    fun destroy() {
+        destroyed = true
+        hide()
+    }
+
+    private fun buildEntries() {
+        clearViews()
+
+        val metrics = activity.resources.displayMetrics
+        val gapPx = (4 * density).toInt()
+
+        val enabledSlots = (HotbarSlotPrefs.MIN_SLOT..HotbarSlotPrefs.MAX_SLOT)
+            .filter { prefs.isSlotEnabled(it) }
+        if (enabledSlots.isEmpty()) return
+
+        // Layout mirrors InbuiltOverlayManager.refreshHotbarSlots: enabled
+        // slots form a row centred at the bottom (120dp from the bottom edge),
+        // 4dp apart; a slot that was manually moved keeps its saved position.
+        val totalWidth = enabledSlots.sumOf { (prefs.getSlotSizeDp(it) * density).toInt() } +
+            gapPx * (enabledSlots.size - 1)
+        val defaultY = maxOf(0, metrics.heightPixels - (120 * density).toInt())
+        var autoX = maxOf(0, (metrics.widthPixels - totalWidth) / 2)
+
+        for (slot in enabledSlots) {
+            val sizePx = (prefs.getSlotSizeDp(slot) * density).toInt()
+            val savedX = prefs.getSlotX(slot)
+            val savedY = prefs.getSlotY(slot)
+            val x = if (savedX != HotbarSlotPrefs.UNPLACED) savedX else autoX
+            val y = if (savedY != HotbarSlotPrefs.UNPLACED) savedY else defaultY
+
+            val button = HotbarSlotButton(activity, slot = slot, listener = this).apply {
+                alpha = prefs.getSlotOpacityPercent(slot) / 100f
+            }
+            val entry = Entry(slot, button, sizePx)
+            addViewForEntry(entry, clampX(x, sizePx), clampY(y, sizePx))
+            entries.add(entry)
+
+            if (savedX == HotbarSlotPrefs.UNPLACED) autoX += sizePx + gapPx
+        }
+    }
+
+    private fun addViewForEntry(entry: Entry, x: Int, y: Int) {
+        val params = WindowManager.LayoutParams(
+            entry.sizePx,
+            entry.sizePx,
+            WindowManager.LayoutParams.TYPE_APPLICATION_PANEL,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
+                or WindowManager.LayoutParams.FLAG_SPLIT_TOUCH,
+            PixelFormat.TRANSLUCENT
+        )
+        params.gravity = Gravity.TOP or Gravity.START
+        params.x = x
+        params.y = y
+        params.token = activity.window.decorView.windowToken
+        try {
+            windowManager.addView(entry.button, params)
+            entry.wmParams = params
+            entry.x = x
+            entry.y = y
+            return
+        } catch (ignored: Exception) {
+            // Panel windows can be refused in some configurations; fall back to
+            // embedding the buttons into the Activity content view.
+        }
+
+        val root = activity.findViewById<ViewGroup>(android.R.id.content)
+        if (root == null) {
+            return
+        }
+        val frame = ViewGroup.MarginLayoutParams(entry.sizePx, entry.sizePx)
+        frame.leftMargin = x
+        frame.topMargin = y
+        root.addView(entry.button, frame)
+        entry.frameParams = frame
+        entry.x = x
+        entry.y = y
+    }
+
+    private fun clearViews() {
+        for (entry in entries) {
+            try {
+                if (entry.wmParams != null) {
+                    windowManager.removeView(entry.button)
+                } else {
+                    (entry.button.parent as? ViewGroup)?.removeView(entry.button)
+                }
+            } catch (ignored: Exception) {
+            }
+        }
+        entries.clear()
+    }
+
+    // --- HotbarSlotButton.Listener -----------------------------------------
+
+    override fun onSlotKey(slot: Int, down: Boolean) {
+        // 1) Android key event routed through the game window (no-op until the
+        //    game surface is focused and consumes it).
+        try {
+            val code = KeyEvent.KEYCODE_1 + (slot - 1)
+            val now = SystemClock.uptimeMillis()
+            activity.dispatchKeyEvent(
+                KeyEvent(now, now, if (down) KeyEvent.ACTION_DOWN else KeyEvent.ACTION_UP, code, 0)
+            )
+        } catch (ignored: Exception) {
+        }
+        // 2) Native path: handled by the Hotbar Slot C++ module once its in-game
+        //    hooks land (selecting the slot / item detection). Until then this
+        //    is a harmless no-op on the native side.
+        HotbarSlotController.currentModule()?.selectSlotNative(slot - 1, down)
+    }
+
+    override fun onDragStart(slot: Int) {
+        entries.firstOrNull { it.slot == slot }?.let { entry ->
+            entry.dragBaseReady = false
+        }
+    }
+
+    override fun onDragMove(slot: Int, dx: Float, dy: Float) {
+        val entry = entries.firstOrNull { it.slot == slot } ?: return
+        if (!entry.dragBaseReady) {
+            entry.dragBaseX = entry.x - dx.toInt()
+            entry.dragBaseY = entry.y - dy.toInt()
+            entry.dragBaseReady = true
+        }
+        updateEntryPosition(entry, entry.dragBaseX + dx.toInt(), entry.dragBaseY + dy.toInt())
+    }
+
+    override fun onDragEnd(slot: Int) {
+        val entry = entries.firstOrNull { it.slot == slot } ?: return
+        entry.dragBaseReady = false
+        prefs.setSlotPosition(entry.slot, entry.x, entry.y)
+    }
+
+    // --- positioning helpers -------------------------------------------------
+
+    private fun updateEntryPosition(entry: Entry, x: Int, y: Int) {
+        val newX = clampX(x, entry.sizePx)
+        val newY = clampY(y, entry.sizePx)
+        entry.wmParams?.let { params ->
+            params.x = newX
+            params.y = newY
+            windowManager.updateViewLayout(entry.button, params)
+        }
+        entry.frameParams?.let { params ->
+            params.leftMargin = newX
+            params.topMargin = newY
+            entry.button.layoutParams = params
+        }
+        entry.x = newX
+        entry.y = newY
+    }
+
+    private fun clampX(x: Int, width: Int): Int {
+        val metrics = activity.resources.displayMetrics
+        return x.coerceIn(0, maxOf(0, metrics.widthPixels - width))
+    }
+
+    private fun clampY(y: Int, height: Int): Int {
+        val metrics = activity.resources.displayMetrics
+        return y.coerceIn(0, maxOf(0, metrics.heightPixels - height))
+    }
+
+    companion object {
+        private const val ICON_POLL_MS = 200L
+        private const val SHOW_RETRIES = 50
+    }
+}
