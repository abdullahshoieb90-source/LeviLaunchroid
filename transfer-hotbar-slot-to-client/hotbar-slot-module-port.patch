@@ -0,0 +1,98 @@
+package com.bedrock.client.modules.impl
+
+import com.bedrock.client.modules.GameModule
+import com.bedrock.client.modules.hotbarslot.HotbarSlotController
+
+/**
+ * Hotbar Slot — ported from LeviLaunchroid's inbuilt "hotbar_slot" module.
+ *
+ * Adds 9 separate on-screen buttons (one per hotbar slot) that float over the
+ * game and can be used to select hotbar slots 1..9. Every button can be moved
+ * by long-pressing and dragging it, and its position is persisted. The
+ * "use item icons" preference (`hotbar_slot_item_icons`, off by default) turns
+ * a button into a hollow frame as soon as the game reports an item in that
+ * slot, so the real vanilla hotbar item stays visible through the middle.
+ *
+ * Kotlin side (this class + modules/hotbarslot package) owns the UI and the
+ * per-slot settings; the C++ side (cpp/modules/impl/hotbar_slot.*) owns the
+ * in-game behaviour (real slot selection / item presence) and is wired through
+ * the native methods below. All native calls are guarded so the module works
+ * (as an overlay) even when the optional native library is not loaded.
+ */
+class HotbarSlotModule : GameModule(
+    NAME,
+    "أزرار منفصلة 1-9 لاختيار خانات الـ Hotbar داخل اللعبة",
+    Category.CLIENT
+) {
+
+    override fun onEnable() {
+        ensureNative()
+        nativeSetEnabled(true)
+        HotbarSlotController.notifyEnabled(true)
+    }
+
+    override fun onDisable() {
+        ensureNative()
+        nativeSetEnabled(false)
+        HotbarSlotController.notifyEnabled(false)
+    }
+
+    /** Selects a hotbar slot in the game (slotIndex is 0-based, 0..8). */
+    fun selectSlotNative(slotIndex: Int, down: Boolean) {
+        if (!ensureNative()) return
+        try {
+            nativeSelectSlot(slotIndex, down)
+        } catch (ignored: UnsatisfiedLinkError) {
+            nativeAvailable = false
+        }
+    }
+
+    /** Whether the given hotbar slot (0-based) currently holds an item. */
+    fun hasItemNative(slotIndex: Int): Boolean {
+        if (!ensureNative()) return false
+        return try {
+            nativeHasItem(slotIndex)
+        } catch (ignored: UnsatisfiedLinkError) {
+            nativeAvailable = false
+            false
+        }
+    }
+
+    private fun nativeSetEnabled(enabled: Boolean) {
+        if (!nativeAvailable) return
+        try {
+            nativeSetEnabledImpl(enabled)
+        } catch (ignored: UnsatisfiedLinkError) {
+            nativeAvailable = false
+        }
+    }
+
+    /**
+     * Probes the native side once: with libbedrock_client absent (the native
+     * component is optional in this app) every call below would throw
+     * UnsatisfiedLinkError, so we detect that once and stop calling. The probe
+     * uses nativeHasItem(0), which has no side effects.
+     */
+    private fun ensureNative(): Boolean {
+        if (probed) return nativeAvailable
+        probed = true
+        nativeAvailable = try {
+            nativeHasItem(0)
+            true
+        } catch (ignored: UnsatisfiedLinkError) {
+            false
+        }
+        return nativeAvailable
+    }
+
+    private external fun nativeSetEnabledImpl(enabled: Boolean)
+    private external fun nativeSelectSlot(slotIndex: Int, down: Boolean)
+    private external fun nativeHasItem(slotIndex: Int): Boolean
+
+    private var nativeAvailable = false
+    private var probed = false
+
+    companion object {
+        const val NAME = "Hotbar Slot"
+    }
+}
