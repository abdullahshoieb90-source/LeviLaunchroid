+package com.bedrock.client.modules.hotbarslot
+
+import android.content.Context
+
+/**
+ * Persistent settings for the Hotbar Slot module (ported from LeviLaunchroid's
+ * `InbuiltModManager` overlay settings).
+ *
+ * The key names intentionally mirror the original launcher so saved values are
+ * easy to reason about:
+ *  - hotbar_slot_enabled_<n>   -> whether slot n (1..9) is shown
+ *  - hotbar_slot_size_<n>      -> button size in dp (default 56)
+ *  - hotbar_slot_opacity_<n>   -> button opacity in % 0..100 (default 100)
+ *  - hotbar_slot_x_<n> / y_<n> -> saved top-left position in px (-1 = not yet placed,
+ *                                 the host lays the row out automatically)
+ * and one module-wide flag: hotbar_slot_item_icons.
+ */
+class HotbarSlotPrefs(context: Context) {
+
+    private val prefs = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    fun isIconsEnabled(): Boolean = prefs.getBoolean(KEY_ITEM_ICONS, false)
+
+    fun setIconsEnabled(enabled: Boolean) {
+        prefs.edit().putBoolean(KEY_ITEM_ICONS, enabled).apply()
+    }
+
+    fun isSlotEnabled(slot: Int): Boolean =
+        prefs.getBoolean(enabledKey(slot), true)
+
+    fun setSlotEnabled(slot: Int, enabled: Boolean) {
+        prefs.edit().putBoolean(enabledKey(slot), enabled).apply()
+    }
+
+    fun getSlotSizeDp(slot: Int): Int =
+        prefs.getInt(sizeKey(slot), DEFAULT_BUTTON_SIZE_DP)
+
+    fun setSlotSizeDp(slot: Int, sizeDp: Int) {
+        val clamped = sizeDp.coerceIn(MIN_SIZE_DP, MAX_SIZE_DP)
+        prefs.edit().putInt(sizeKey(slot), clamped).apply()
+    }
+
+    fun getSlotOpacityPercent(slot: Int): Int =
+        prefs.getInt(opacityKey(slot), DEFAULT_OPACITY_PERCENT)
+
+    fun setSlotOpacityPercent(slot: Int, opacity: Int) {
+        prefs.edit().putInt(opacityKey(slot), opacity.coerceIn(0, 100)).apply()
+    }
+
+    /** Saved position x in px, or -1 when the slot was never moved by the user. */
+    fun getSlotX(slot: Int): Int = prefs.getInt(xKey(slot), UNPLACED)
+
+    fun getSlotY(slot: Int): Int = prefs.getInt(yKey(slot), UNPLACED)
+
+    fun setSlotPosition(slot: Int, x: Int, y: Int) {
+        prefs.edit()
+            .putInt(xKey(slot), x)
+            .putInt(yKey(slot), y)
+            .apply()
+    }
+
+    private fun enabledKey(slot: Int) = "hotbar_slot_enabled_$slot"
+    private fun sizeKey(slot: Int) = "hotbar_slot_size_$slot"
+    private fun opacityKey(slot: Int) = "hotbar_slot_opacity_$slot"
+    private fun xKey(slot: Int) = "hotbar_slot_x_$slot"
+    private fun yKey(slot: Int) = "hotbar_slot_y_$slot"
+
+    companion object {
+        private const val PREFS_NAME = "preferences"
+        const val KEY_ITEM_ICONS = "hotbar_slot_item_icons"
+
+        const val MIN_SLOT = 1
+        const val MAX_SLOT = 9
+        const val UNPLACED = -1
+
+        /** Same defaults as LeviLaunchroid's InbuiltModManager. */
+        const val DEFAULT_BUTTON_SIZE_DP = 56
+        const val DEFAULT_OPACITY_PERCENT = 100
+        const val MIN_SIZE_DP = 24
+        const val MAX_SIZE_DP = 120
+    }
+}
