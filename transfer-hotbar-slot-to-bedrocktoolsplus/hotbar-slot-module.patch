+#pragma once
+
+#include "../Module.hpp"
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+namespace bedrocktools::sdk { class Player; }
+
+// Hotbar Slot — ported from LeviLaunchroid's inbuilt "hotbar_slot" module.
+//
+// LeviLauncher's version added nine separate 1..9 overlay buttons above the
+// game so the player could select hotbar slots without touching the tiny
+// vanilla hotbar, with a per-slot enabled flag and an "use item icons" mode
+// that turns a button into a see-through window (so the vanilla hotbar item
+// stays visible under the number).
+//
+// Inside the game this becomes an on-screen HUD row: nine slot cells labelled
+// 1..9 whose content mirrors the original — a number by default, or an
+// icon window (no number) once the game reports an item in that slot while
+// the icons mode is on. Slots can be hidden individually, and the whole row
+// can be placed with the HUD editor (hudPosX/hudPosY) and scaled (m_size).
+class HotbarSlotModule : public Module {
+public:
+    HotbarSlotModule();
+    ~HotbarSlotModule() override;
+
+    void onInit() override;
+    void onDisable() override;
+    void onMenuRegistered() override;
+    void onFrame() override;
+    void loadConfig(const nlohmann::json& json) override;
+    void saveConfig(nlohmann::json& json) override;
+
+private:
+    static constexpr int SlotCount = 9;
+
+    void refreshRuntime(bedrocktools::sdk::Player* player);
+    bool slotVisible(int slot) const;
+    float rowWidth() const;
+
+    // Runtime state (written on the game tick thread, read on the render
+    // frame thread).
+    std::array<std::atomic_bool, SlotCount> m_hasItem{};
+
+    // Settings — the row is one HUD element draggable from the HUD editor.
+    std::mutex m_configMutex;
+    float hudPosX = -1.0f;   // -1 = keep the auto bottom-center placement
+    float hudPosY = -1.0f;
+    bool isHudModule = true;
+
+    float m_size = 56.0f;        // cell size in px
+    float m_gap = 4.0f;          // px between cells
+    bool m_background = true;    // dark cell backing (like the overlay button)
+    float m_opacity = 1.0f;      // overall opacity 0..1
+    bool m_iconsMode = false;    // "use item icons": hollow window over items
+    bool m_show1 = true;
+    bool m_show2 = true;
+    bool m_show3 = true;
+    bool m_show4 = true;
+    bool m_show5 = true;
+    bool m_show6 = true;
+    bool m_show7 = true;
+    bool m_show8 = true;
+    bool m_show9 = true;
+};
