+#include "hotbarslot.hpp"
+
+#include "modules/ModuleRegistry.hpp"
+
+#include <bedrocktools/events/EventBus.hpp>
+#include <bedrocktools/sdk/offsets/Inventory.hpp>
+
+#include <pl/ModMenuConfig.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace {
+
+using namespace bedrocktools::sdk::offsets::Inventory;
+
+template <class T>
+T read(const void* object, std::size_t offset) {
+    return *reinterpret_cast<const T*>(static_cast<const std::byte*>(object) + offset);
+}
+
+// Reads whether each of the 9 hotbar slots (container indices 0..8) currently
+// holds an item. Uses exactly the same container walk as
+// src/core/InventoryAccess.cpp (same published offsets).
+bool readHotbarHasItem(const void* player, std::array<bool, 9>& out) {
+    out.fill(false);
+    if (!player) return false;
+    const void* proxy = read<const void*>(player, PlayerInventory);
+    if (!proxy) return false;
+    const void* inventory = read<const void*>(proxy, PlayerInventoryContainer);
+    if (!inventory) return false;
+    const auto begin = read<std::uintptr_t>(inventory, FillingContainerItems);
+    const auto end = read<std::uintptr_t>(inventory, FillingContainerItems + sizeof(void*));
+    if (!begin && !end) return true;  // empty container, nothing to read
+    if (!begin || !end || end < begin || begin % alignof(void*) != 0) return false;
+    const auto bytes = end - begin;
+    if (bytes % ItemStackSize != 0) return false;
+    const auto size = bytes / ItemStackSize;
+    if (size < 9 || size > 64) return false;
+    for (int i = 0; i < 9; ++i) {
+        const void* stack = reinterpret_cast<const void*>(begin + static_cast<std::size_t>(i) * ItemStackSize);
+        const bool valid = read<std::uint8_t>(stack, ItemStackValid) != 0;
+        const auto count = read<std::uint8_t>(stack, ItemStackCount);
+        out[static_cast<std::size_t>(i)] = valid && count > 0;
+    }
+    return true;
+}
+
+std::uint32_t colorWithOpacity(std::uint32_t rgb, float opacity) {
+    const auto alpha = static_cast<std::uint32_t>(
+        std::clamp(opacity, 0.0f, 1.0f) * 255.0f
+    );
+    return (alpha << 24U) | (rgb & 0x00FFFFFFU);
+}
+
+}  // namespace
+
+HotbarSlotModule::HotbarSlotModule()
+    : Module("Hotbar Slot", "Shows the 1-9 hotbar slots as an on-screen row (ported from LeviLauncher's Hotbar Slot module).") {}
+
+HotbarSlotModule::~HotbarSlotModule() = default;
+
+void HotbarSlotModule::onInit() {
+    bedrocktools::events::bus().subscribe<bedrocktools::events::LocalPlayerTickEvent>(
+        [this](auto& event) { refreshRuntime(event.player); }
+    );
+}
+
+void HotbarSlotModule::onDisable() {
+    for (auto& cell : m_hasItem) cell.store(false, std::memory_order_release);
+}
+
+void HotbarSlotModule::refreshRuntime(bedrocktools::sdk::Player* player) {
+    if (!enabled) return;
+    std::array<bool, 9> items{};
+    if (readHotbarHasItem(player, items)) {
+        for (int i = 0; i < SlotCount; ++i) {
+            m_hasItem[static_cast<std::size_t>(i)].store(items[static_cast<std::size_t>(i)], std::memory_order_release);
+        }
+    }
+}
+
+bool HotbarSlotModule::slotVisible(int slot) const {
+    switch (slot) {
+        case 0: return m_show1;
+        case 1: return m_show2;
+        case 2: return m_show3;
+        case 3: return m_show4;
+        case 4: return m_show5;
+        case 5: return m_show6;
+        case 6: return m_show7;
+        case 7: return m_show8;
+        default: return m_show9;
+    }
+}
+
+float HotbarSlotModule::rowWidth() const {
+    int visible = 0;
+    for (int i = 0; i < SlotCount; ++i) {
+        if (slotVisible(i)) ++visible;
+    }
+    if (visible == 0) return 0.0f;
+    const float cell = std::clamp(m_size, 16.0f, 160.0f);
+    const float gap = std::clamp(m_gap, 0.0f, 48.0f);
+    return cell * static_cast<float>(visible) + gap * static_cast<float>(visible - 1);
+}
+
+void HotbarSlotModule::onFrame() {
+    if (!enabled) return;
+
+    const float cell = std::clamp(m_size, 16.0f, 160.0f);
+    const float gap = std::clamp(m_gap, 0.0f, 48.0f);
+    const float width = rowWidth();
+    const float opacity = std::clamp(m_opacity, 0.0f, 1.0f);
+    const float radius = std::max(2.0f, cell * 0.2f);
+
+    const pl::modmenu::HudSurfaceSize surface = pl::modmenu::getHudSurfaceSize();
+
+    // Placement: the row auto-centers above the vanilla hotbar until the user
+    // moves it once with the HUD editor (which then persists hudPosX/Y).
+    const float startX = hudPosX >= 0.0f
+        ? hudPosX
+        : (surface.width > width ? (surface.width - width) * 0.5f : 0.0f);
+    const float startY = hudPosY >= 0.0f
+        ? hudPosY
+        : (surface.height > 0.0f ? surface.height - 140.0f : 40.0f);
+
+    // HUD editor element so the row can be dragged/resized from the launcher.
+    std::vector<pl::modmenu::HudEditorElement> elements;
+    pl::modmenu::HudEditorElement element;
+    element.elementId = "hotbarRow";
+    element.displayName = "Hotbar Slots";
+    element.positionKeyX = "hudPosX";
+    element.positionKeyY = "hudPosY";
+    element.x = startX;
+    element.y = startY;
+    element.width = std::max(1.0f, width);
+    element.height = std::max(1.0f, cell);
+    elements.push_back(std::move(element));
+    pl::modmenu::submitHudEditorElements(moduleId, elements);
+
+    std::vector<pl::modmenu::DrawCommand> commands;
+    commands.reserve(static_cast<std::size_t>(SlotCount) * 2);
+    // Keeps the number labels alive until submitDrawCommands() has consumed
+    // the command list (DrawCommand::text may be a raw pointer).
+    std::vector<std::string> labels;
+    labels.reserve(SlotCount);
+
+    float cursorX = startX;
+    for (int slot = 0; slot < SlotCount; ++slot) {
+        if (!slotVisible(slot)) continue;
+
+        const bool hasItem = m_hasItem[static_cast<std::size_t>(slot)].load(std::memory_order_acquire);
+        const bool iconWindow = m_iconsMode && hasItem;
+
+        if (m_background) {
+            pl::modmenu::DrawCommand bg{};
+            bg.type = pl::modmenu::DrawCommandType::RectFilled;
+            bg.x = cursorX;
+            bg.y = startY;
+            bg.w = cell;
+            bg.h = cell;
+            bg.x3 = radius;
+            // Item-icon windows use a light tint so the vanilla hotbar item
+            // stays visible underneath (the original button's "hole").
+            bg.color = colorWithOpacity(0x000000U, iconWindow ? opacity * 0.22f : opacity * 0.62f);
+            commands.push_back(std::move(bg));
+        }
+
+        if (!iconWindow) {
+            labels.emplace_back(1, static_cast<char>('1' + slot));
+            pl::modmenu::DrawCommand label{};
+            label.type = pl::modmenu::DrawCommandType::Text;
+            label.x = cursorX + cell * 0.5f;
+            label.y = startY + cell * 0.5f + cell * 0.5f * 0.35f;
+            label.w = -2.0f;  // horizontally centred anchor
+            label.color = colorWithOpacity(0xFFFFFFU, opacity);
+            label.size = cell * 0.5f;
+            label.text = labels.back().c_str();
+            commands.push_back(std::move(label));
+        }
+
+        cursorX += cell + gap;
+    }
+
+    pl::modmenu::submitDrawCommands(moduleId, commands);
+}
+
+void HotbarSlotModule::loadConfig(const nlohmann::json& json) {
+    Module::loadConfig(json);
+    std::lock_guard lock(m_configMutex);
+    if (json.contains("hudPosX")) hudPosX = json["hudPosX"].get<float>();
+    if (json.contains("hudPosY")) hudPosY = json["hudPosY"].get<float>();
+    if (json.contains("isHudModule")) isHudModule = json["isHudModule"].get<bool>();
+    if (json.contains("m_size")) m_size = std::clamp(json["m_size"].get<float>(), 16.0f, 160.0f);
+    if (json.contains("m_gap")) m_gap = std::clamp(json["m_gap"].get<float>(), 0.0f, 48.0f);
+    if (json.contains("m_background")) m_background = json["m_background"].get<bool>();
+    if (json.contains("m_opacity")) m_opacity = std::clamp(json["m_opacity"].get<float>(), 0.0f, 1.0f);
+    if (json.contains("m_iconsMode")) m_iconsMode = json["m_iconsMode"].get<bool>();
+    if (json.contains("m_show1")) m_show1 = json["m_show1"].get<bool>();
+    if (json.contains("m_show2")) m_show2 = json["m_show2"].get<bool>();
+    if (json.contains("m_show3")) m_show3 = json["m_show3"].get<bool>();
+    if (json.contains("m_show4")) m_show4 = json["m_show4"].get<bool>();
+    if (json.contains("m_show5")) m_show5 = json["m_show5"].get<bool>();
+    if (json.contains("m_show6")) m_show6 = json["m_show6"].get<bool>();
+    if (json.contains("m_show7")) m_show7 = json["m_show7"].get<bool>();
+    if (json.contains("m_show8")) m_show8 = json["m_show8"].get<bool>();
+    if (json.contains("m_show9")) m_show9 = json["m_show9"].get<bool>();
+}
+
+void HotbarSlotModule::saveConfig(nlohmann::json& json) {
+    Module::saveConfig(json);
+    std::lock_guard lock(m_configMutex);
+    json["hudPosX"] = hudPosX;
+    json["hudPosY"] = hudPosY;
+    json["isHudModule"] = isHudModule;
+    json["m_size"] = m_size;
+    json["m_gap"] = m_gap;
+    json["m_background"] = m_background;
+    json["m_opacity"] = std::clamp(m_opacity, 0.0f, 1.0f);
+    json["m_iconsMode"] = m_iconsMode;
+    json["m_show1"] = m_show1;
+    json["m_show2"] = m_show2;
+    json["m_show3"] = m_show3;
+    json["m_show4"] = m_show4;
+    json["m_show5"] = m_show5;
+    json["m_show6"] = m_show6;
+    json["m_show7"] = m_show7;
+    json["m_show8"] = m_show8;
+    json["m_show9"] = m_show9;
+}
+
+void HotbarSlotModule::onMenuRegistered() {
+    using namespace pl::modmenu;
+
+    ConfigSchemaBuilder schema;
+    schema.defaultCategory("slots")
+        .category("slots", "Slots", "Choose which hotbar slots are shown")
+        .category("appearance", "Appearance", "Size, spacing, opacity and icon mode");
+
+    auto node = [](const char* key, const char* title, const char* category, ConfigControlTypeV2 type) {
+        ConfigNodeV2 value;
+        value.id = key;
+        value.key = key;
+        value.title = title;
+        value.category = category;
+        value.type = type;
+        return value;
+    };
+
+    auto slotsGroup = node("hotbarSlots", "Show Slots", "slots", ConfigControlTypeV2::ToggleGroup);
+    slotsGroup.key.clear();
+    slotsGroup.choiceStyle = ConfigChoiceStyleV2::Chips;
+    static constexpr const char* kSlotNames[] = {"1", "2", "3", "4", "5", "6", "7", "8", "9"};
+    std::vector<std::string> slotKeys;
+    slotKeys.reserve(SlotCount);
+    for (int slot = 1; slot <= SlotCount; ++slot) {
+        slotKeys.push_back("m_show" + std::to_string(slot));
+        slotsGroup.options.push_back({slotKeys.back().c_str(), kSlotNames[slot - 1], {}, slotKeys.back().c_str()});
+    }
+    schema.node(std::move(slotsGroup));
+    schema.node(node("keybind", "Toggle Keybind", "slots", ConfigControlTypeV2::Keybind));
+
+    auto size = node("m_size", "Slot Size", "appearance", ConfigControlTypeV2::SliderFloat);
+    size.minValue = "16";
+    size.maxValue = "160";
+    size.step = "1";
+    size.unit = " px";
+    schema.node(std::move(size));
+
+    auto gap = node("m_gap", "Slot Gap", "appearance", ConfigControlTypeV2::SliderFloat);
+    gap.minValue = "0";
+    gap.maxValue = "48";
+    gap.step = "1";
+    gap.unit = " px";
+    schema.node(std::move(gap));
+
+    schema.node(node("m_background", "Background", "appearance", ConfigControlTypeV2::Toggle));
+    schema.node(node("m_iconsMode", "Use Item Icons", "appearance", ConfigControlTypeV2::Toggle));
+
+    auto opacity = node("m_opacity", "Opacity", "appearance", ConfigControlTypeV2::SliderFloat);
+    opacity.minValue = "0";
+    opacity.maxValue = "1";
+    opacity.step = "0.01";
+    opacity.visibleWhen = {{"m_background", ConfigConditionOpV2::Truthy, {}}};
+    schema.node(std::move(opacity));
+
+    setConfigSchemaJson(moduleId, schema.toJson());
+}
